# Configuración del entorno - Monitorías USB

# Puerto de la API
PORT=4000
NODE_ENV=development

# Conexión a PostgreSQL (local o Supabase/Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monitorias_usb?schema=public"

# Seguridad JWT
JWT_SECRET="super-secret-key-usb-monitorias-2026-cucuta"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-refresh-key-usb-monitorias-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Configuración de Reglas de Negocio
TARGET_HOURS_PER_SEMESTER=54
DEFAULT_ACADEMIC_PERIOD="2026-2"
